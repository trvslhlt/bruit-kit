{
  "name": "web-audio-toy-kit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/columns.css": "./dist/ui/columns.css",
    "./ui/waveformView.css": "./dist/ui/waveformView.css",
    "./ui/waveformRangeView.css": "./dist/ui/waveformRangeView.css",
    "./ui/sliderControl.css": "./dist/ui/sliderControl.css",
    "./ui/automationEditor.css": "./dist/ui/automationEditor.css",
    "./ui/stepSequencerEditor.css": "./dist/ui/stepSequencerEditor.css",
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio/index.js"
    },
    "./midi": {
      "types": "./dist/midi/index.d.ts",
      "import": "./dist/midi/index.js"
    },
    "./sources": {
      "types": "./dist/sources/index.d.ts",
      "import": "./dist/sources/index.js"
    },
    "./sources/granular-processor.js": "./dist/sources/granular-processor.js"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && mkdir -p dist/ui && cp src/ui/*.css dist/ui/ && mkdir -p dist/sources && cp src/sources/granular-processor.js dist/sources/",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "typecheck:demo": "tsc --noEmit -p demo/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  }
}
